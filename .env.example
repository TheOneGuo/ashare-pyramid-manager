# 节节高 · 环境变量示例
# 复制为 .env 填入真实值；.env 已被 .gitignore 拦掉，绝对不能提交。
# （本文件此前存在 UTF-8 编码损坏，已重新整理）

# —— 数据库（沿用 Foresig 项目的 Turso / libsql）——
# 形如：libsql://<your-db>.turso.io
TURSO_DATABASE_URL=
# Turso 颁发的 JWT；只在该机/构建环境使用，不要 commit / 截图 / 转发
TURSO_AUTH_TOKEN=
# Turso 出网代理（本机 Clash 常为 http://127.0.0.1:7897）。
# 注意：直连东京 Turso 在本机经常不通，务必配置；不填会回落 NEWS_PROXY_URL
TURSO_PROXY_URL=
# 新闻源出网代理
NEWS_PROXY_URL=

# —— 后端 API ——
# uniCloud / Express / 自托管服务，结尾不要带 /
API_BASE_URL=

# —— 安全（重要）——
# 写接口鉴权密钥：设置后所有写操作必须带 x-api-key（或 Authorization: Bearer）。
# 生产环境【必须设置】：未设置时生产模式下所有写接口一律返回 401（fail-closed）。
API_KEY=
# 生产环境标记：设为 production 会启用 fail-closed 等安全基线
NODE_ENV=
# 允许的跨域来源，逗号分隔（生产必填，留空会在开发模式放行 localhost）
ALLOWED_ORIGINS=
# 全局限流：每 IP 每窗口最大请求数（0 表示关闭；默认 1000 / 5 分钟）
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
# 单次全量刷新硬超时（毫秒，默认 120000）。防止上游挂起导致定时刷新不再续排
REFRESH_TIMEOUT_MS=
# 宏观源 / LLM 请求超时（毫秒，默认 15000 / 90000）
MACRO_FETCH_TIMEOUT_MS=
LLM_TIMEOUT_MS=

# —— 研报（fxbaogao.com）——
# 高级 VIP 开通后获取：https://www.fxbaogao.com/user/userInfo
# 用作研报搜索 / 段落获取 / PDF 下载。绝不能 commit。
FXBAOGAO_API_KEY=

# —— LLM（研报 AI 精读）——
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
