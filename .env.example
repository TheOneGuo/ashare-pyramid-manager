# 节节高 · 环境变量示例
# 复制为 .env 填入真实值；.env 已被 .gitignore 拦掉，绝对不能提交。

# —— 数据库 (沿用 Foresig 项目的 Turso / libsql) ——
# 形如：libsql://<your-db>.turso.io
TURSO_DATABASE_URL=
# Turso 颁发的 JWT；只在该机/构建环境使用，不要 commit / 截图 / 转发
TURSO_AUTH_TOKEN=

# —— 后端 API ——
# uniCloud / Express / 自托管服务，结尾不要带 /
API_BASE_URL=

