# 后端服务环境变量（绝对不能 commit）
# 复制为 .env 填入真实值

# Turso 数据库（沿用 Foresig 项目）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Express 服务端口
PORT=9999

# 30 秒刷新用的新闻源
# 留空则使用内置 mock（开发期）
NEWS_SOURCE_MODE=mock

# 电报源抓取代理（t.me / rsshub 直连被墙，需走本地 Clash）
# akshare-service 与电报频道源都依赖它
NEWS_PROXY_URL=http://127.0.0.1:7897

# Turso（libSQL）读写代理
# 库在东京：国内直连 TCP 不通（表现为所有 SQL「fetch failed」、采集整批写不进去），
# 必须走代理。留空则回落到 NEWS_PROXY_URL；显式写 off 表示强制直连。
TURSO_PROXY_URL=http://127.0.0.1:7897

# 可选：RSSHub 基址（默认 rsshub.app,rsshub.moeyy.cn）
# 公共实例常 403/超时，失败会自动回退 t.me/s/ HTML，可按需追加可用镜像
# TELEGRAM_RSS_BASES=https://rsshub.app,https://rsshub.moeyy.cn

# LLM 解读（可选）  -  项目全局 LLM（gpt-agent.cc，OpenAI-compatible）
# 走 chatJson() 的所有功能（fxbaogao PDF 精读 / 持仓标的研报 等）
# 失效时 refineExternalReport 走 mock 兜底
LLM_API_KEY=
LLM_BASE_URL=https://gpt-agent.cc/v1
LLM_MODEL=MiniMax-M3

# 行情数据 provider（开发期=akshare，上架前切 compliant 合规源）
DATA_PROVIDER=akshare
# akshare 微服务地址（Python/FastAPI，端口 8800）
AKSHARE_SERVICE_URL=http://127.0.0.1:8800

# —— 财经快讯过滤（读取层：不删库，随时调参；接口 ?raw=1 可单次绕过看原始流）——
# 只保留与「A股/美股标的、中美政策法规、地缘政治、航道、关键原材料」相关的快讯，
# 并做跨源近似去重 + 每源配额（避免低频源被高频源挤出）
# NEWS_FILTER_OFF=1            # 全局关闭过滤（排查误杀时用）
# NEWS_MIN_PER_SOURCE=5       # 每个活跃源保底条数
# NEWS_MAX_SOURCE_RATIO=0.45  # 单源在单页中的占比上限

# —— 发现报告 (fxbaogao.com) MCP ——
# 高级 VIP 开通后获取：https://www.fxbaogao.com/user/userInfo
FXBAOGAO_API_KEY=
